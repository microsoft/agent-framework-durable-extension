# Azure Functions Runtime Configuration
FUNCTIONS_WORKER_RUNTIME=python
AzureWebJobsStorage=UseDevelopmentStorage=true

# Durable Task Scheduler Configuration
# Required before running: replace durablesamplev2UNIQUE below with the same fresh,
# unique hub unused by older workers in both TASKHUB_NAME and the connection string.
# For Azure: Get connection string from Azure portal
DURABLE_TASK_SCHEDULER_CONNECTION_STRING=Endpoint=http://localhost:8080;TaskHub=durablesamplev2UNIQUE;Authentication=None
TASKHUB_NAME=durablesamplev2UNIQUE
# REQUIRED acknowledgement. Leave blank until the fresh hub is configured and all
# workers and clients use schema 2, then explicitly set this to isolated_v2.
DURABLE_AGENTS_DEPLOYMENT_MODE=

# Azure AI Foundry Configuration
FOUNDRY_PROJECT_ENDPOINT=https://your-project.services.ai.azure.com/api/projects/your-project
FOUNDRY_MODEL=your-deployment-name
